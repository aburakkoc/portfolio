{
  // Cloudflare Workers config. This site is static assets only — there is no
  // server-side script, so there is no "main" entry point.
  //
  // Everything inside public/ is uploaded and served at the site root, so
  // public/index.html becomes /, and public/assets/css/style.css becomes
  // /assets/css/style.css. Files outside public/ (this config, the README)
  // are never served.
  "name": "portfolio",
  "compatibility_date": "2026-10-25",

  "assets": {
    "directory": "./public",

    // Serve public/404.html for unknown paths instead of a bare Cloudflare
    // error page. Do NOT change this to "single-page-application" — that would
    // return index.html with a 200 for every bad URL, which confuses search
    // engines.
    "not_found_handling": "404-page"
  },

  // Attaching the domain here means `wrangler deploy` creates the custom
  // domain and its DNS record, and keeps them in sync. To also serve
  // www.aburakkoc.com, add a second entry with that pattern.
  "routes": [
    { "pattern": "aburakkoc.com", "custom_domain": true }
  ],

  // Attaching a custom domain turns the portfolio.*.workers.dev URL off by
  // default, which is what we want: one canonical hostname, no duplicate copy
  // of the site for search engines to find. Set this to true if you ever want
  // the workers.dev URL back as a staging link.
  "workers_dev": false,

  "observability": {
    "enabled": true
  }
}
