{
  // Cloudflare Workers config. This site is static assets only — there is no
  // server-side script, so there is no "main" entry point.
  //
  // Everything inside public/ is uploaded and served at the site root, so
  // public/index.html becomes /, and public/assets/css/style.css becomes
  // /assets/css/style.css. Files outside public/ (this config, the README)
  // are never served.
  "name": "portfolio",
  "compatibility_date": "2026-10-25",

  "assets": {
    "directory": "./public",

    // Serve public/404.html for unknown paths instead of a bare Cloudflare
    // error page. Do NOT change this to "single-page-application" — that would
    // return index.html with a 200 for every bad URL, which confuses search
    // engines.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
